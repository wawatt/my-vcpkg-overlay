{   
    "name":"wawatt",
    "version":"1.0.0",
    "dependencies": [
        "assimp",
        "asio",
        "boost-locale",
        "boost-dll",
        "boost-stacktrace",
        {
            "name": "bullet3",
            "features": ["multithreading","double-precision","rtti"]
        },
        "casadi",
        {
            "name": "ccd",
            "features": ["double-precision"]
        },
        {
            "name": "ceres",
            "features": ["eigensparse", "lapack", "suitesparse"]
        },
        "console-bridge",
        "cppad",
        "eigen3",
        "fcl",
        "glog",
        "gflags",
        "grpc",
        "gtest",
        "hpp-fcl",
        "jsoncpp",
        "magic-enum",
        "nlohmann-json",
        "nodeeditor",
        "nu-book-zxing-cpp",
        "octomap",
        "ompl",
        {
            "name": "opencv4",
            "features": ["eigen","contrib","dnn","ipp","freetype","openmp","thread","tiff","opencl","tbb"]
        },
        {
            "name": "openvino",
            "default-features": false,
            "features": ["auto","auto-batch","cpu","gpu","ir","onnx"]
        },
        "orocos-kdl",
        {
            "name": "pcl",
            "features": ["visualization","simulation", "surface-on-nurbs"]
        },
        "pinocchio3",
        "pinocchio",
        "qt5-base",
        "qt5-svg",
        "qt5-tools",
        "sophus",
        "spdlog",
        "tinyxml",
        "toppra",
        "yaml-cpp",
        "urdfdom"
    ],
    "overrides": [
        {
            "name": "eigen3",
            "version": "3.4.0#5"
        },
        {
            "name": "openvino",
            "version": "2025.3.0"
        }
    ],
    "vcpkg-configuration": {
        "overlay-triplets": [ "my-vcpkg-overlay/triplets" ],
        "overlay-ports": [ "my-vcpkg-overlay" ],
        "default-registry": {
            "kind": "git",
            "repository": "https://github.com/Microsoft/vcpkg",
            "baseline": "2e6fcc44573d091af0321f99c89b212997a76f1f"
        }
    }
}