{
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "git",
      "baseline": "2e6fcc44573d091af0321f99c89b212997a76f1f",
      "repository": "https://github.com/Microsoft/vcpkg"
    },
    "overlay-ports": [
      "my-vcpkg-overlay"
    ],
    "overlay-triplets": [
      "my-vcpkg-overlay/triplets"
    ]
  },
  "name": "wawatt",
  "version": "1.0.0",
  "dependencies": [
    "asio",
    "assimp",
    "boost-dll",
    "boost-locale",
    "boost-stacktrace",
    {
      "name": "bullet3",
      "features": [
        "double-precision",
        "multithreading",
        "rtti"
      ]
    },
    "casadi",
    {
      "name": "ccd",
      "features": [
        "double-precision"
      ]
    },
    {
      "name": "ceres",
      "features": [
        "eigensparse",
        "lapack",
        "suitesparse"
      ]
    },
    "console-bridge",
    "cppad",
    "cppzmq",
    "eigen3",
    "fcl",
    "fftw3",
    "gflags",
    "glog",
    "grpc",
    "gtest",
    "hpp-fcl",
    "jsoncpp",
    "libpcap",
    "magic-enum",
    "nlohmann-json",
    "nu-book-zxing-cpp",
    "octomap",
    "ompl",
    {
      "name": "opencv4",
      "features": [
        "contrib",
        "dnn",
        "eigen",
        "freetype",
        "ipp",
        "opencl",
        "openmp",
        "tbb",
        "thread",
        "tiff"
      ]
    },
    {
      "name": "openvino",
      "default-features": false,
      "features": [
        "auto",
        "auto-batch",
        "cpu",
        "gpu",
        "hetero",
        "ir",
        "onnx"
      ]
    },
    "orocos-kdl",
    {
      "name": "pcl",
      "features": [
        "simulation",
        "surface-on-nurbs",
        "visualization"
      ]
    },
    "pinocchio3",
    "qt5-base",
    "qt5-svg",
    "qt5-tools",
    "qtbase",
    "qtnodes",
    "sophus",
    "spdlog",
    "robotraconteur",
    "robotraconteur-companion",
    "taskflow",
    "tinyxml",
    "descartes-light",
    "osqp",
    "osqp-eigen",
    "tesseract-planning",
    "tesseract-robotics",
    "trajopt",
    "toppra",
    "urdfdom",
    "yaml-cpp",
    "zeromq"
  ],
  "overrides": [
    {
      "name": "eigen3",
      "version": "3.4.0#5"
    },
    {
      "name": "level-zero",
      "version": "1.32.0#1"
    },
    {
      "name": "openvino",
      "version": "2026.1.0#1"
    }
  ]
}
