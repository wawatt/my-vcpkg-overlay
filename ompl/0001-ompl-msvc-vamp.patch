+constexpr std::array<double, 7> kStartConfig = {0., -0.785, 0., -2.356, 0., 1.571, 0.785};
+constexpr std::array<double, 7> kGoalConfig = {2.35, 1., 0., -0.8, 0., 2.5, 0.785};
+
+vamp::collision::Environment<float> makeSphereCage()
+{
+    vamp::collision::Environment<float> env_float;
+    constexpr float radius = 0.2f;
+    for (const auto &obs : obstacles)
+    {
+        env_float.spheres.emplace_back(vamp::collision::factory::sphere::array(obs, radius));
+    }
+    env_float.sort();
+    return env_float;
+}
+
+void setStartGoal(og::SimpleSetup &ss)
+{
+    auto space = ss.getStateSpace();
+    ob::ScopedState<> start(space);
+    ob::ScopedState<> goal(space);
+    for (std::size_t i = 0; i < Robot::dimension; ++i)
+    {
+        start[i] = kStartConfig[i];
+        goal[i] = kGoalConfig[i];
+    }
+    ss.setStartAndGoalStates(start, goal);
+}
+
+void configureVampSimd(og::SimpleSetup &ss, const Environment &env)
+{
+    auto si = ss.getSpaceInformation();
+    si->setStateValidityChecker(std::make_shared<ompl::vamp::VampStateValidityChecker<Robot>>(si, env));
+    si->setMotionValidator(std::make_shared<ompl::vamp::VampMotionValidator<Robot>>(si, env));
+}
+
+// Same Panda FK / spheres, but edges are checked one interpolated state at a time
+// (OMPL DiscreteMotionValidator) instead of VAMP's 8-wide SIMD edge check.
+void configureScalarMotion(og::SimpleSetup &ss, const Environment &env)
+{
+    auto si = ss.getSpaceInformation();
+    // Match VAMP's ~Robot::resolution samples per unit L2 in C-space.
+    // Set this before DiscreteMotionValidator caches longestValidSegment.
+    const double spacing = 1.0 / static_cast<double>(Robot::resolution);
+    const double extent = si->getStateSpace()->getMaximumExtent();
+    si->getStateSpace()->setLongestValidSegmentFraction(spacing / extent);
+    si->getStateSpace()->setup();
+    si->setStateValidityChecker(std::make_shared<ompl::vamp::VampStateValidityChecker<Robot>>(si, env));
+    si->setMotionValidator(std::make_shared<ob::DiscreteMotionValidator>(si));
+}
+
+struct TrialStats
+{
+    int success = 0;
+    std::vector<double> times_ms;
+};
+
+void printStats(const std::string &label, const TrialStats &s)
+{
+    auto times = s.times_ms;
+    std::sort(times.begin(), times.end());
+    const double sum = std::accumulate(s.times_ms.begin(), s.times_ms.end(), 0.0);
+    const double mean = s.times_ms.empty() ? 0.0 : sum / static_cast<double>(s.times_ms.size());
+    const double median = times.empty() ? 0.0 : times[times.size() / 2];
+    const double mn = times.empty() ? 0.0 : times.front();
+    const double mx = times.empty() ? 0.0 : times.back();
+    std::cout << label << '\n';
+    std::cout << "  success: " << s.success << '/' << s.times_ms.size() << '\n';
+    std::cout << std::fixed << std::setprecision(3);
+    std::cout << "  time ms: mean=" << mean << "  median=" << median << "  min=" << mn << "  max=" << mx << '\n';
+}
+
+TrialStats runTrials(bool vamp_simd, int n, double timeout, unsigned seed)
+{
+    auto env_float = makeSphereCage();
+    Environment env(env_float);
+    TrialStats stats;
+    ompl::RNG::setSeed(seed);
+    for (int i = 0; i < n; ++i)
+    {
+        auto space = std::make_shared<ompl::vamp::VampStateSpace<Robot>>();
+        og::SimpleSetup ss(space);
+        if (vamp_simd)
+        {
+            configureVampSimd(ss, env);
+        }
+        else
+        {
+            configureScalarMotion(ss, env);
+        }
+        setStartGoal(ss);
+        ss.setPlanner(std::make_shared<og::RRTConnect>(ss.getSpaceInformation()));
+
+        const auto t0 = std::chrono::steady_clock::now();
+        const auto status = ss.solve(ob::timedPlannerTerminationCondition(timeout));
+        const auto t1 = std::chrono::steady_clock::now();
+        const double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();
+        stats.times_ms.push_back(ms);
+        const bool ok = status == ob::PlannerStatus::EXACT_SOLUTION;
+        if (ok)
+        {
+            ++stats.success;
+        }
+        std::cout << "  trial " << (i + 1) << '/' << n << (vamp_simd ? " [SIMD] " : " [scalar] ") << std::fixed
+                  << std::setprecision(2) << ms << " ms  " << (ok ? "OK" : "FAIL") << std::endl;
+    }
+    return stats;
+}
+
+void compareAcceleration(int n, double timeout)
+{
+    std::cout << "Comparing VAMP SIMD edge checks vs OMPL DiscreteMotionValidator\n";
+    std::cout << "  robot=Panda  planner=RRTConnect  timeout=" << timeout << "s  trials=" << n << '\n';
+    std::cout << "  SIMD width (rake)=" << vamp::FloatVectorWidth << "  VAMP resolution=" << Robot::resolution
+#ifdef __AVX2__
+              << "  AVX2=ON"
+#else
+              << "  AVX2=OFF"
+#endif
+              << '\n';
+    std::cout << "  Both modes use VAMP Panda FK. SIMD uses vectorized edge validation;\n"
+              << "  scalar uses one isValid() per interpolated state.\n\n";
+
+    constexpr unsigned seed = 42;
+    std::cout << "--- VAMP SIMD ---\n";
+    const auto simd = runTrials(true, n, timeout, seed);
+    printStats("SIMD summary", simd);
+
+    std::cout << "\n--- OMPL discrete (no SIMD edge check) ---\n";
+    const auto scalar = runTrials(false, n, timeout, seed);
+    printStats("scalar summary", scalar);
+
+    const double simd_mean =
+        simd.times_ms.empty() ? 0.0 :
+                                std::accumulate(simd.times_ms.begin(), simd.times_ms.end(), 0.0) /
+                                    static_cast<double>(simd.times_ms.size());
+    const double scalar_mean =
+        scalar.times_ms.empty() ? 0.0 :
+                                  std::accumulate(scalar.times_ms.begin(), scalar.times_ms.end(), 0.0) /
+                                      static_cast<double>(scalar.times_ms.size());
+    std::cout << "\n=== Speedup (scalar mean / SIMD mean) ===\n";
+    if (simd_mean > 0.0)
+    {
+        std::cout << std::fixed << std::setprecision(2) << "  " << (scalar_mean / simd_mean) << "x\n";
+    }
+}
