+	# cl.exe / clang-cl do not accept GCC warning or -f/-m/-O3 flags.
+	set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${VAMP_ARCH} /permissive- /bigobj")
+	set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${VAMP_ARCH}")
+	return()
+endif()
+
 # default fast args that work on all platforms
